{
  "name": "revenue-metrics-service",
  "version": "1.0.0",
  "description": "Zero-drift Revenue Metrics Service with multi-source status allow-list normalization backed by Supabase Postgres",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "db:push": "npx supabase db push --linked",
    "db:push:seed": "npx supabase db push --linked --include-seed",
    "db:migration:list": "npx supabase migration list --linked",
    "db:seed": "ts-node src/scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-drift": "ts-node src/scripts/checkDrift.ts"
  },
  "keywords": [
    "revenue-metrics",
    "zero-drift",
    "supabase",
    "stripe",
    "multi-source-ingestion",
    "backend-assignment"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "stripe": "^16.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
